# Power Automate signed HTTP trigger URL; blank disables Teams delivery.
POWER_AUTOMATE_URL=

# === Airnet (web scraper) ===
BASE_URL=https://example.com/AirnetWeb/index.jsf
USERNAME=your_username
PASSWORD=your_password

# === OneSense service alerts (GET; fibre ID as service_name, range=15m) ===
# Shared D1, NPAW, and OneSense API proxy routing
# Blank preserves HTTP_PROXY / HTTPS_PROXY / NO_PROXY behavior
# Set to your proxy endpoint, for example http://proxy.example.com:8080
PROXY_URL=
ONESENSE_API_URL=
ONESENSE_API_KEY=

# === NPAW combined API (GET with internetId; no authentication) ===
# NPAW_API_URL=https://api.npaw.example.com

# === Cloudflare D1 (runtime token requires D1 write permission for run logs and retention) ===
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
